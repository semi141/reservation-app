<% if room.errors.any? %>
  <div style="color: red; margin-bottom: 20px;">
    <h2><%= room.errors.count %>件のエラーがあります：</h2>
    <ul>
      <% room.errors.messages.each do |attribute, messages| %>
        <% messages.each do |msg| %>
          <li><%= room.class.human_attribute_name(attribute) %> <%= msg %></li>
        <% end %>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: room, url: rooms_path, method: :post, local: true, data: { turbo: false } do |f| %>
  <div>
    <%= f.label :name, "施設名" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :detail, "紹介文" %><br>
    <%= f.text_area :detail %>
  </div>

  <div>
    <%= f.label :price, "宿泊料金" %><br>
    <%= f.number_field :price, min: nil, step: 1 %>
  </div>

  <div>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :image, "施設画像" %><br>
    <%= f.file_field :image %>
  </div>

<div>
  <%= f.label :capacity, "定員" %><br>
  <%= f.number_field :capacity, min: 1 %>
</div>


  <div style="margin-top: 15px;">
    <%= f.submit "登録する", class: "btn btn-primary" %>
  </div>
<% end %>
