<h1>検索結果</h1>
<p>合計件数: <%= @rooms.count %> 件</p>

<% @rooms.each do |room| %>
  <div>
    <% if room.image.attached? %>
      <%= image_tag room.image, style: "max-width: 200px; height: auto;" %>
    <% else %>
      <%= image_tag "default_room.jpg", style: "max-width: 200px; height: auto;" %>
    <% end %>

    <h2><%= link_to room.name, room_path(room) %></h2>
    <p>住所: <%= room.address %></p>
    <p>紹介文: <%= room.detail %></p>
    <p>料金: <%= number_to_currency(room.price, unit: "¥") %> / 日</p>
    <p>作成日: <%= room.created_at.strftime("%Y/%m/%d %H:%M") %></p>
  </div>
  <%= back_to_index_button(rooms_path) %>
<% end %>

