<h1>自分の施設一覧</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>施設名</th>
      <th>画像</th>
      <th>紹介文</th>
      <th>宿泊料金</th>
      <th>作成日</th>
    </tr>
  </thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td><%= link_to room.name, room_path(room) %></td>
        <td>
          <% if room.image.attached? %>
            <%= image_tag room.image, style: "max-width: 100px; height: auto;" %>
          <% else %>
            <%= image_tag "default_room.jpg", style: "max-width: 100px; height: auto;" %>
          <% end %>
        </td>
        <td><%= room.detail %></td>
        <td><%= number_with_delimiter(room.price) %>円/日</td>
        <td><%= room.created_at.strftime('%Y/%m/%d %H:%M') %></td>
      </tr>
    <% end %>
  </tbody>
</table>
