<h1>自分の予約一覧</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>宿泊施設</th>
      <th>画像</th>
      <th>紹介文</th>
      <th>チェックイン</th>
      <th>チェックアウト</th>
      <th>宿泊日数</th>
      <th>人数</th>
      <th>合計料金</th>
      <th>予約確定日時</th>
      <th>詳細</th>
    </tr>
  </thead>
  <tbody>
    <% @reservations.each do |reservation| %>
      <tr>
        <td><%= reservation.room.name %></td>
        <td>
          <% if reservation.room.image.attached? %>
            <%= image_tag reservation.room.image, style: "max-width: 100px; height: auto;" %>
          <% else %>
            <%= image_tag "default_room.jpg", style: "max-width: 100px; height: auto;" %>
          <% end %>
        </td>
        <td><%= reservation.room.description %></td>
        <td><%= reservation.check_in.strftime('%Y/%m/%d %H:%M') %></td>
        <td><%= reservation.check_out.strftime('%Y/%m/%d %H:%M') %></td>
        <td><%= reservation.stay_days %>泊</td>
        <td><%= reservation.number_of_people %></td>
        <td><%= number_with_delimiter(reservation.total_price) %>円</td>
        <td><%= reservation.created_at.strftime('%Y/%m/%d %H:%M') %></td>
        <td><%= link_to '詳細', reservation_path(reservation), class: "btn btn-outline-secondary" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
