<%= form_with(model: @reservation, url: confirm_reservations_path, local: true, data: { turbo: false }) do |f| %>
  <%= f.hidden_field :room_id, value: @reservation.room_id || @room&.id %>

  <% if @reservation.errors.any? %>
    <div class="error-messages">
      <h2><%= @reservation.errors.count %>件のエラーがあります：</h2>
      <ul>
        <% @reservation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :check_in, "チェックイン日" %><br>
    <%= f.date_field :check_in, value: @reservation.check_in %>
  </div>

  <div>
    <%= f.label :check_out, "チェックアウト日" %><br>
    <%= f.date_field :check_out, value: @reservation.check_out %>
  </div>

  <div>
    <%= f.label :number_of_people, "人数" %><br>
    <%= f.number_field :number_of_people, min: nil, step: 1 %>
  </div>

  <div>
    <%= f.submit "確認へ進む" %>
  </div>
<% end %>